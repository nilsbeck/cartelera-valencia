# Copy this file to .env on your host (next to docker-compose.yml) and
# fill in the values. .env is gitignored.

# TMDB v3 API key
TMDB_API_KEY=

# Fine-grained PAT or classic token with `contents: write` on this repo
GH_TOKEN=

# Optional — defaults shown
# REPO_URL=https://github.com/nilsbeck/cartelera-valencia.git
# GIT_USER_NAME=cartelera-scraper
# GIT_USER_EMAIL=scraper@your-host

# ── Notifications (Apprise) ───────────────────────────────────────────
# Whitespace- or comma-separated list of Apprise service URLs. Leave
# blank to disable. See https://github.com/caronc/apprise/wiki for the
# full list of supported services and URL syntax.
#
# Examples:
#   mailto://user:app-password@smtp.gmail.com
#   mailtos://user:pass@smtp.fastmail.com:465?from=me@example.com&to=me@example.com
#   tgram://bot-token/chat-id
#   discord://webhook-id/webhook-token
APPRISE_URLS=

# Set to 1 to also send a notification on clean runs (default: only on
# warnings / fatal errors).
# APPRISE_NOTIFY_ON_SUCCESS=1
